# Copy to .env and replace all example values before local use.
POSTGRES_DB=ethiofleet
POSTGRES_USER=ethiofleet
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
# Use a unique secret of at least 32 UTF-8 bytes; never commit a real secret.
Authentication__Jwt__SigningKey=replace-with-at-least-32-random-bytes
